# Sanitized example only. Verify physical interface names before use.

auto lo
iface lo inet loopback

# Proxmox management bridge
auto vmbr0
iface vmbr0 inet static
    address 10.10.40.100/24
    gateway 10.10.40.1
    bridge-ports nic0
    bridge-stp off
    bridge-fd 0

# Dedicated firewall WAN path
auto vmbr1
iface vmbr1 inet manual
    bridge-ports nic1
    bridge-stp off
    bridge-fd 0

# Optional isolated test path
auto vmbr2
iface vmbr2 inet manual
    bridge-ports nic2
    bridge-stp off
    bridge-fd 0

# VLAN-aware internal trunk
auto vmbr3
iface vmbr3 inet manual
    bridge-ports nic3
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 10 20 30 40 50 60 70
